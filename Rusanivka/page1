<img
src = "https://lh3.googleusercontent.com/pw/AP1GczOvF9sZ6VutqcyAnD1VIASwZfhL99Gs3nCVZ6GttJQyCE7r746WnwwAFu2drkDyYUO2yeMCaBde60MDlGEhqAWt8qf5ilQFNX_xeY8Qs7ltxjdlN8M=w2400"
alt = "Набережна"
